# {{ ansible_managed }}
# Cilium {{ cilium_version }} - CNI + kube-proxy replacement + L2 LoadBalancer announcements
kubeProxyReplacement: true
# No kube-proxy => Cilium must reach the API server directly (not via the kubernetes Service)
k8sServiceHost: "{{ ansible_host }}"
k8sServicePort: 6443
ipam:
  mode: kubernetes            # per-node podCIDR allocated by kube-controller-manager from {{ kube_pod_cidr }}
operator:
  replicas: 1                 # single node: the default 2 would leave one Pending (anti-affinity)
# LoadBalancer IPs announced via ARP on the LAN (pool/policy CRs come from GitOps)
l2announcements:
  enabled: true
externalIPs:
  enabled: true
# L2 announcements use leases; Cilium docs recommend raising the client rate limit
k8sClientRateLimit:
  qps: 10
  burst: 20
gatewayAPI:
  enabled: {{ cilium_gateway_api | bool | lower }}
hubble:
  enabled: true
  relay:
    enabled: true
  ui:
    enabled: {{ cilium_hubble_ui | bool | lower }}
