# {{ ansible_managed }}
# Calico {{ calico_version }} via tigera-operator. kube-proxy stays (iptables mode); Istio ambient chains istio-cni on top.
installation:
  cni:
    type: Calico
  # Prometheus metrics (homelab-gitops scrapes them): Felix on every node, Typha via Service
  # calico-system/calico-typha-metrics. kube-controllers already serves 9094 by default.
  nodeMetricsPort: {{ calico_felix_metrics_port }}
  typhaMetricsPort: {{ calico_typha_metrics_port }}
  calicoNetwork:
    bgp: Disabled
    # Pin node IP detection to the Kubernetes InternalIP (first-found could pick tailscale0 / 100.x)
    nodeAddressAutodetectionV4:
      kubernetes: NodeInternalIP
    ipPools:
      - name: default-ipv4-ippool
        cidr: "{{ kube_pod_cidr }}"
        encapsulation: {{ calico_encapsulation }}
        natOutgoing: Enabled
        nodeSelector: all()
tigeraOperator:
  env:
    - name: METRICS_ENABLED       # operator metrics on 0.0.0.0:9484
      value: "true"
