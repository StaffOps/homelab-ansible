# {{ ansible_managed }}
# Calico {{ calico_version }} via tigera-operator. kube-proxy stays (iptables mode); Istio ambient chains istio-cni on top.
installation:
  cni:
    type: Calico
  calicoNetwork:
    bgp: Disabled
    # Pin node IP detection to the Kubernetes InternalIP (first-found could pick tailscale0 / 100.x)
    nodeAddressAutodetectionV4:
      kubernetes: NodeInternalIP
    ipPools:
      - name: default-ipv4-ippool
        cidr: "{{ kube_pod_cidr }}"
        encapsulation: {{ calico_encapsulation }}
        natOutgoing: Enabled
        nodeSelector: all()
