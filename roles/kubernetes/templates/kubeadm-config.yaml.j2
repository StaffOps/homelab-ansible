# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ ansible_host }}"
  bindPort: 6443
nodeRegistration:
  name: "{{ ansible_hostname }}"
  criSocket: unix:///run/containerd/containerd.sock
# Resource requests for the static pods (files written by the role)
patches:
  directory: /etc/kubernetes/patches
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ _kubeadm_version.stdout }}"
clusterName: "{{ inventory_hostname }}"
controlPlaneEndpoint: "{{ ansible_host }}:6443"
networking:
  podSubnet: "{{ kube_pod_cidr }}"
  serviceSubnet: "{{ kube_service_cidr }}"
apiServer:
  certSANs:
{% for san in kube_cert_sans %}
    - "{{ san }}"
{% endfor %}
  extraArgs:
    - name: encryption-provider-config
      value: /etc/kubernetes/enc/encryption-config.yaml
    - name: audit-policy-file
      value: /etc/kubernetes/audit/policy.yaml
    - name: audit-log-path
      value: /var/log/kubernetes/audit/audit.log
    - name: audit-log-maxage
      value: "{{ kube_audit_log_maxage }}"
    - name: audit-log-maxbackup
      value: "{{ kube_audit_log_maxbackup }}"
    - name: audit-log-maxsize
      value: "{{ kube_audit_log_maxsize }}"
  extraVolumes:
    - name: encryption-config
      hostPath: /etc/kubernetes/enc
      mountPath: /etc/kubernetes/enc
      readOnly: true
      pathType: Directory
    - name: audit-policy
      hostPath: /etc/kubernetes/audit
      mountPath: /etc/kubernetes/audit
      readOnly: true
      pathType: Directory
    - name: audit-log
      hostPath: /var/log/kubernetes/audit
      mountPath: /var/log/kubernetes/audit
      readOnly: false
      pathType: DirectoryOrCreate
# Metrics for Prometheus (homelab-gitops). 0.0.0.0 is safe: UFW denies incoming except from the pod/service
# CIDRs, SSH and 6443; controller-manager/scheduler metrics also require authn/authz.
controllerManager:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
scheduler:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
etcd:
  local:
    extraArgs:
      # keep 127.0.0.1: kubeadm's etcd probes use it; the node IP is for Prometheus (plain HTTP, no auth)
      - name: listen-metrics-urls
        value: "http://127.0.0.1:2381,http://{{ ansible_host }}:2381"
      # per-method gRPC latency histograms (grpc_server_handling_seconds_*), used by the etcd mixin dashboards
      - name: metrics
        value: "extensive"
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
metricsBindAddress: "{{ kube_proxy_metrics_bind }}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# Kubelet serving cert signed by the cluster CA via CSR (metrics-server can verify it; no --kubelet-insecure-tls)
serverTLSBootstrap: true
