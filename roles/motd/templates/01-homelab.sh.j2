#!/bin/bash
# {{ ansible_managed }}
C='\033[1;36m'; G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; D='\033[0;37m'; N='\033[0m'

printf "${C}"
if command -v figlet >/dev/null 2>&1; then figlet -f standard "{{ motd_title }}"; else echo "=== {{ motd_title }} ==="; fi
printf "${N}"

. /etc/os-release
host=$(hostname -f 2>/dev/null || hostname)
ip=$(hostname -I | awk '{print $1}')
up=$(uptime -p | sed 's/^up //')
load=$(cut -d' ' -f1-3 /proc/loadavg)
cpus=$(nproc)
mem=$(free -m | awk '/^Mem:/ {printf "%d/%d MiB (%d%%)", $3, $2, $3*100/$2}')
disk=$(df -h / | awk 'NR==2 {printf "%s/%s (%s)", $3, $2, $5}')
users=$(who | wc -l)

row() { printf "  ${D}%-12s${N} %b\n" "$1" "$2"; }
echo
row "Host"     "${G}${host}${N}  [{{ motd_environment }}]"
row "IP"       "$ip"
row "OS"       "$PRETTY_NAME  ($(uname -r))"
row "Uptime"   "$up"
row "Load"     "$load  (${cpus} vCPU)"
row "Memory"   "$mem"
row "Disk /"   "$disk"
row "Sessions" "$users"

if command -v k3s >/dev/null 2>&1; then
  if systemctl is-active --quiet k3s; then
    ver=$(k3s --version 2>/dev/null | awk 'NR==1{print $3}')
    nodes=$(timeout 3 k3s kubectl get nodes --no-headers 2>/dev/null | awk '{s[$2]++} END {for (k in s) printf "%s %s ", s[k], k}')
    pods=$(timeout 3 k3s kubectl get pods -A --no-headers 2>/dev/null | awk '$4!="Running" && $4!="Completed"' | wc -l)
    row "k3s" "${G}active${N} ${ver}  nodes: ${nodes:-?}  pods not ready: ${pods}"
  else
    row "k3s" "${R}inactive${N}"
  fi
fi

f2b=$(fail2ban-client status sshd 2>/dev/null | awk -F: '/Currently banned/ {gsub(/[ \t]/,"",$2); print $2}')
row "Security" "ufw: $(ufw status 2>/dev/null | awk 'NR==1{print $2}')  fail2ban banned: ${f2b:-0}"
echo
printf "  ${Y}Acesso monitorado. Uso restrito a pessoas autorizadas.${N}\n\n"
